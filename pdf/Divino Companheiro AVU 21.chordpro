## ----- icone de olho/alerta -----
{start_of_svg: align="left"}
<svg width="60mm" height="6mm" viewBox="0 0 60 6" xmlns="http://w3.org">
  <!-- Desenho do Olho (Contorno Externo) -->
  <path d="M 1 3 C 2.5 1.2, 4.5 1.2, 6 3 C 4.5 4.8, 2.5 4.8, 1 3 Z" fill="none" stroke="#D32F2F" stroke-width="0.5" />
  <!-- Íris/Pupila (Círculo Interno) -->
  <circle cx="3.5" cy="3" r="1" fill="#D32F2F" />
  <!-- Linha contínua horizontal que sai do lado do olho -->
  <line x1="8" y1="3" x2="60" y2="3" stroke="#D32F2F" stroke-width="0.3" />
</svg>
{end_of_svg}
